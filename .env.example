# Auth (Cognito) — Creator pool
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT=http://localhost:5173

# Auth (Cognito) — Restaurant/Partner pool (separate pool, see template.yaml RestaurantUserPool)
VITE_COGNITO_RESTAURANT_USER_POOL_ID=
VITE_COGNITO_RESTAURANT_APP_CLIENT_ID=

# API
VITE_API_BASE_URL=
VITE_AI_API_ENDPOINT=

# External APIs (backend only — set in Lambda env vars)
# GOOGLE_PLACES_API_KEY=
# ANTHROPIC_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=

# App
VITE_APP_VERSION=0.1.0
VITE_PLATFORM_NAME=Spot Platform
VITE_DEMO_MODE=true

# Feature Flags (all default to true in demo mode if unset)
VITE_ENABLE_RESTAURANT_PORTAL=true
VITE_ENABLE_MEMBERSHIP=true
VITE_ENABLE_MULTI_CREATOR=false
VITE_ENABLE_AMBASSADOR=true

# Scheduling / Booking (Calendly)
# Set to your Calendly link to enable the "Book a Demo" section on the landing page
VITE_CALENDLY_URL=https://calendly.com/spot-platform/demo
